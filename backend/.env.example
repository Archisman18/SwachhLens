# Database Connection (SQLite default or Supabase / Postgres)
# SQLite (zero setup):
DATABASE_URL=sqlite+aiosqlite:///./swachhlens.db
# Supabase PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Groq Cloud AI API Key (for LLM Vision Triage & Classification)
GROQ_API_KEY=your_groq_api_key_here

# Supabase Storage & Auth (for waste photos)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=waste-photos

# Environment
ENV=development
